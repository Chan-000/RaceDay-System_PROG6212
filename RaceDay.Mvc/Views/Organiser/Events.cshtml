@model List<RaceDay.Contracts.EventDto>

@{
	ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="fw-bold">Manage Events</h1>
			<p class="text-muted">
				View, edit and delete the events you have created.
			</p>
		</div>

		<a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-primary">+ Create Event</a>
	</div>

	@if (Model == null || !Model.Any())
	{
		<div class="card shadow-sm border-0">
			<div class="card-body text-center py-5">
				<h5>No Events Found</h5>
				<p class="text-muted">You have not created any events yet</p>

				<a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-primary">Create Your First Event</a>
			</div>
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body">

				<div class="table-responsive">
					<table class="table table-hover align-middle">

						<thead class="table-dark">
							<tr>
								<th>Event Name</th>
								<th>Date</th>
								<th>Location</th>
								<th>Distance</th>
								<th>Event Type</th>
								<th>Max Participants</th>
								<th>Actions</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td class="fw-bold">@item.EventName</td>
									<td>@item.EventDate.ToString("dd MMM yyyy")</td>
									<td>@item.Location</td>
									<td>@item.DistanceKm</td>
									<td>
										<span class="badge bg-info text-dark">@item.EventTypeName</span>
									</td>
									<td>@item.MaxParticipants</td>

									<td>

										<div class="d-flex gap-2">

											<a asp-action="Categories" asp-route-eventId="@item.EventID" class="btn btn-sm btn-info">Categories</a>
											<a asp-action="EditEvent" asp-route-id="@item.EventID" class="btn btn-sm btn-primary">Edit</a>
											
											<form asp-action="DeleteEvent"
											      asp-route-id="@item.EventID"
											      method="post"
											      onsubmit="return confirm('Are you sure you want to delete this event?');">

												 @Html.AntiForgeryToken()

												 <button type="submit" class="btn btn-sm btn-danger">Delete</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
	
</div>