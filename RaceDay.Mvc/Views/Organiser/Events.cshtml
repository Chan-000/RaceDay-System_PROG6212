@model List<RaceDay.Contracts.EventDto>

@{
	ViewData["Title"] = "Manage Events";
}

<div class="container">
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show">
			@TempData["Success"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

		</div>
	}
	
	<div class="d-flex justify-content-between align-items-centre mb-4">
		<div>
			<h1 class="fw-bold">Manage Events</h1>
			<p class="text-muted">
				View and manage the race events you have created
			</p>
		</div>

		<a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-primary">+ Create Event</a>
	</div>
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">@TempData["Error"]</div>
	}

	@if (Model == null || !Model.Any())
	{
		<div class="card shadow-sm border-0">
			<div class="card-body text-center py-5">
				<h5>No Events Found</h5>
				<p class="text-muted">You have not created any events yet</p>

				<a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-primary">Create Your First Event</a>
			</div>
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body">

				<div class="table-responsive">
					<table class="table table-hover align-middle">

						<thead class="table-dark">
							<tr>
								<th>Event Name</th>
								<th>Date</th>
								<th>Location</th>
								<th>Distance</th>
								<th>Event Type</th>
								<th>Max Participants</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td class="fw-bold">@item.EventName</td>
									<td>@item.EventDate.ToString("dd MMM yyy")</td>
									<td>@item.Location</td>
									<td>@item.DistanceKm</td>
									<td>
										<span class="badge bg-info text-dark">@item.EventTypeName</span>
									</td>
									<td>@item.MaxParticipants</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

			</div>
		</div>
	}
	
</div>