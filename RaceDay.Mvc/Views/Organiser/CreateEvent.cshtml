@model RaceDay.Mvc.ViewModels.EventFormVm

@{
    ViewData["Title"] = "Create Event";
}

<div class="container">

    <div class="mb-4">
        <a asp-controller="Organiser" asp-action="Events" class="text-decoration-none">
            ← Back to Events
        </a>

        <h1 class="fw-bold mt-3">Create a New Event</h1>

        <p class="text-muted">
            Enter the details below to create a new RaceDay event
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Organiser" asp-action="CreateEvent" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" placeholder="For exp: CapeTown Open Marathon"/>
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the event...."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control"/>
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="Enter event location"/>
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" 
                               placeholder="For exp: 10"/>
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" 
                               type="number"
                               min="1"
                               class="form-control" 
                               placeholder="For exp: 200"/>
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="EventTypeID" class="form-label"></label>
                    <select asp-for="EventTypeID" class="form-select">

                        <option value="0">-- Select Event Type --</option>
                        @foreach (var type in Model.EventTypes)
                        {
                            <option value="@type.EventTypeID">@type.TypeName</option>
                        }
                    </select>
                    <span asp-validation-for="EventTypeID" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">Create Event</button>
                    <a asp-controller="Organiser" asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}