@model List<RaceDay.Mvc.ViewModels.EventEnrolmentsVm>

@{
	ViewData["Title"] = "Enrolments";
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold mt-3">Enrolments</h2>
			<p class="text-muted">View participants enrolled in your events.</p>
		</div>
	</div>
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (Model == null || !Model.Any())
	{
		<div class="alert alert-info">
			You do not have any events to display yet.
		</div>
	}
	else
	{
		@foreach (var eventItem in Model)
		{
			<div class="card mb-4 shadow-sm">
				<div class="enrolment-event-header">
					<h5 class="mb-0">@eventItem.EventName</h5>
					<span>Event enrolments</span>
				</div>

				<div class="card-body">
					@if (eventItem.Enrolments == null || !eventItem.Enrolments.Any())
					{
						<p class="text-muted mb-0">No participants have enrolled in this event yet.</p>
					}
					else
					{
						<div class="table-responsive">

							<table class="table table-striped table-hover align-middle">
								
								<thead>
									<tr>
										<th>Participant</th>
										<th>Selected Category</th>
										<th>Enrolment Date</th>
										<th>Status</th>
										<th>Result</th>
									</tr>
								</thead>

								<tbody>
									@foreach (var item in eventItem.Enrolments)
									{
										<tr>
											<td>
												@(string.IsNullOrWhiteSpace(item.ParticipantName) 
												     ? "Name unavailable" : item.ParticipantName)
											</td>
											<td>@(item.CategoryName ?? "Not available")</td>
											<td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
											<td>
												@if (item.EnrolmentStatus == "Confirmed")
												{
													<span class="badge bg-success">Confirmed</span>
												}
												else if (item.EnrolmentStatus == "Pending")
												{
													<span class="badge bg-warning text-dark">Pending</span>
												}

												else if(item.EnrolmentStatus == "Cancelled")
												{
													<span class="badge bg-danger">Cancelled</span>
												}
												else
												{
													<span class="badge bg-secondary">@item.EnrolmentStatus</span>
												}
											</td>
											<td>
												@if (item.EnrolmentStatus != "Confirmed")
												{
													<span class="text-muted">Not eligible</span>
												}
												else if (item.ResultID == null)
												{
													<a asp-controller="Organiser" 
													   asp-action="CaptureResult"
													   asp-route-eventId="@eventItem.EventID"
													   asp-route-enrolmentId="@item.EnrolmentID"
													   class="btn btn-sm btn-success">
													    Capture Result
													</a>
												}
												else
												{
													<a asp-controller="Organiser" 
													   asp-action="EditResult"
													   asp-route-id="@item.ResultID"
													   class="btn btn-sm btn-primary">
														Edit Result
													</a>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>

						</div>
					}

				</div>
			</div>
		}
	}
</div>
