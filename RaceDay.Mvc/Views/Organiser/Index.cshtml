@{
	ViewData["Title"] = "Organiser Dashboard";
}

<div class="container">

	<div class="mb-4">
		<h1 class="fw-bold">Organiser Dashboard</h1>
		<p class="text-muted">
			Welcome @ViewBag.DisplayName. Manage your RaceDay activities here.
		</p>
	</div>

	<div class="row g-4">

		<div class="col-md-6 col-lg-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">Manage Events</h5>
					<p class="card-text text-muted">
						Create, update and manage race events.
					</p>
					<span class="badge bg-primary">Coming soon</span>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-lg-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">Categories</h5>
					<p class="card-text text-muted">
						Manage the categories available for your events.
					</p>
					<span class="badge bg-primary">Coming soon</span>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-lg-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">Enrolments</h5>
					<p class="card-text text-muted">
						View and manage participant enrolments.
					</p>
					<span class="badge bg-warning text-dark">Coming soon</span>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-lg-3">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">Results</h5>
					<p class="card-text text-muted">
						Enter and publish race results.
					</p>
					<span class="badge bg-success">Coming soon</span>
				</div>
			</div>
		</div>
	</div>
</div>