@{
	var role = Context.Session.GetString("Role");
	var userId = Context.Session.GetInt32("UserId");
	var displayName = Context.Session.GetString("DisplayName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>@ViewData["Title"] - RaceDay</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg raceday-navbar">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-name">RaceDay</span>
                    <span class="brand-dot">.</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @if (userId == null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                                </li> 
                            }
                            else if (string.Equals(role, "Organiser", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Events">Event Management</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Results">Results</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>
                                </li>
                            }

                        </ul>

                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            @if (userId == null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link  login-link" asp-controller="Auth" asp-action="Login">Login</a>     
                                </li>

                            <li class="nav-item ms-lg-2">
                                    <a class="btn btn-primary register-button" asp-controller="Auth" asp-action="Register">Register</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <span class="navbar-text welcome-text me-lg-3">Welcome, @displayName</span>
                                </li>

                                <li class="nav-item">
                                    <form asp-controller="Auth" asp-action="Logout" method="post">

                                        @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                                    </form>
                                </li>
                            }

                        </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="raceday-footer mt-5">
        <div class="container text-center">
            <p class="mb-0">
                © 2026 RaceDay SA. All rights reserved.
            </p>
            <small>Find your race. Make it count.</small>
        </div>
    </footer >

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>