@{
	ViewData["Title"] = "Participant Dashboard";
}

<div class="container">

	<div class="mb-4"> 
		<h1 class="fw-bold">Welcome to RaceDay!</h1>
		<p class="text-muted">
			Hello @ViewBag.DisplayName. Ready for your next race?
		</p>
	</div>

	<div class="row g-4">

		<div class="col-md-6 col-lg-4">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">Upcoming Events</h5>
					<p class="card-text text-muted">
						Explore upcoming races and find an event to join.
					</p>
					<span class="badge bg-primary">Coming soon</span>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-lg-4">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">My Events</h5>
					<p class="card-text text-muted">
						View the events you have enrolled in and check their status.
					</p>
					<span class="badge bg-primary text-dark">Coming soon</span>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-lg-4">
			<div class="card shadow-sm border-0 h-100">
				<div class="card-body">
					<h5 class="card-title">My Results</h5>
					<p class="card-text text-muted">
						View your race results, finishing times and positions.
					</p>
					<span class="badge bg-success">Coming soon</span>
				</div>
			</div>
		</div>
	</div>
</div>