@model List<RaceDay.Contracts.EnrolmentDto>

@{
	ViewData["Title"] = "My Events";
}

<div class="container py-4">

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]

			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="mb-4">
		<h1 class="fw-bold">My Events</h1>
		<p class="text-muted">
			View the events you have entered and check your enrolment status.
		</p>
	</div>

	<div class="card shadow-sm border-0">

		<div class="card-body">

			<div class="d-flex justify-content-between align-items-center mb-4">
				<h5 class="fw-bold mb-0">Event Entries</h5>
				<span class="badge bg-primary">@Model.Count event</span>
			</div>

			@if (Model.Any())
			{
				<div class="table-responsive">

					<table class="table table-hover align-middle">

						<thead class="table-light">
							<tr>
								<th>Event</th>
								<th>Category</th>
								<th>Enrolment Date</th>
								<th>Status</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var enrolment in Model)
							{
								var statusClass = "bg-secondary";
								if (string.Equals(enrolment.EnrolmentStatus, "Confirmed", StringComparison.OrdinalIgnoreCase))
								{
									statusClass = "bg-success";
								}
								else if (string.Equals(enrolment.EnrolmentStatus, "Pending", StringComparison.OrdinalIgnoreCase))
								{
									statusClass = "bg-warning text-dark";
								}
								else if (string.Equals(enrolment.EnrolmentStatus, "Cancelled", StringComparison.OrdinalIgnoreCase))
								{
									statusClass = "bg-danger";
								}

								<tr>
									<td class="fw-semibold">@enrolment.EventName</td>
									<td>@(enrolment.CategoryName ?? "Not available")</td>
									<td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
									<td>
										<span class="badge @statusClass">@enrolment.EnrolmentStatus</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="text-center py-5">

					<i class="bi bi-calendar-x display-4 text-muted"></i>
					<h5 class="mt-3">You have not entered any events yet.</h5>
					<p class="text-muted">
						Browse upcoming races and enter an event to see it here.
					</p>

					<a asp-controller="Participant" asp-action="Index" class="btn btn-primary">Browse Events</a>
				</div>
			}
		</div>
	</div>

</div>