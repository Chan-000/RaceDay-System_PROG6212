@model RaceDay.Contracts.ProfileDto

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2>My Profile</h2>
        <p class="text-muted">
            View and update your personal account information.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-4">

                    <div class="mb-3">

                        @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                        {
                            <img src="@Url.Action("ProfilePicture", "Images")"
                                 alt="Profile picture"
                                 class="rounded-circle"
                                 style="width: 120px; height: 120px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                 style="width: 120px; height: 120px; font-size: 35px; margin: 0 auto;">
                                @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                            </div>
                        }
                    </div>

                    <h4>@Model.FirstName @Model.LastName</h4>

                    <p class="text-muted mb-2">@Model.Email</p>

                    <span class="badge bg-primary">
                        @Model.Role
                    </span>

                </div>
            </div>
        </div>

        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>

                <div class="card-body">

                    <form asp-controller="Participant" asp-action="Profile" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">First Name</label>

                            <input name="FirstName"
                                   value="@Model.FirstName"
                                   class="form-control"
                                   maxlength="50"
                                   required />

                            <span class="text-danger"
                                  asp-validation-for="FirstName">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Last Name</label>

                            <input name="LastName"
                                   value="@Model.LastName"
                                   class="form-control"
                                   maxlength="50"
                                   required />

                            <span class="text-danger"
                                  asp-validation-for="LastName">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>

                            <input type="email"
                                   value="@Model.Email"
                                   class="form-control"
                                   readonly />

                            <small class="text-muted">
                                Your registered email address cannot be changed here.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>

                            <input type="tel"
                                   name="PhoneNumber"
                                   value="@Model.PhoneNumber"
                                   class="form-control"
                                   maxlength="20" />

                            <span class="text-danger"
                                  asp-validation-for="PhoneNumber">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Account Role</label>

                            <input value="@Model.Role"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-controller="Participant"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Back to Events
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                    <hr class="my-4" />

                    <h4>Profile Picture</h4>

                    <p class="text-muted">
                        Upload a picture for your RaceDay SA profile.
                        The maximum file size is 5MB.
                    </p>

                    <form asp-controller="Participant"
                          asp-action="UploadProfileImage"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="file" class="form-label">Choose Profile Picture</label>

                            <input type="file"
                                   name="file"
                                   id="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.gif,.webp"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Upload Profile Picture
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
